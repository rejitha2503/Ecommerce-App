# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for Prisma integration
DATABASE_URL="postgresql://user:password@localhost:5432/shopsphere?schema=public"

# JWT_SECRET: Private secret payload key for token signs & verifies
JWT_SECRET="super-secret-shopsphere-jwt-signing-key"

# JWT_REFRESH_SECRET: Private secret for issuing refresh tokens
JWT_REFRESH_SECRET="super-secret-shopsphere-refresh-signing-key"

# CLOUDINARY: API configurations for product and review uploads
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# STRIPE: Keys for Stripe Payment Processing
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# RAZORPAY: Credentials for Razorpay Payment Engine
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_razorpay_secret"
